#!/usr/bin/env bash
set -euo pipefail

missing=()
for package in php-cli php-xml php-mbstring php-curl php-zip composer; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
    missing+=("$package")
  fi
done

if (( ${#missing[@]} )); then
  echo 'Installing PHP development prerequisites'
  sudo apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi

echo 'Installing Composer dependencies'
time composer install --no-interaction --prefer-dist
